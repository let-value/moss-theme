  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#1D1D1D",
    "parameter": "#1D1D1D",
    "property": "#3F5B48",
    "function": "#63501F",
    "method": "#63501F",
    "type": "#006B64",
    "class": "#006B64",
    "interface": "#006B64",
    "variable.readonly": "#1D1D1D",
    "number": "#005E86",
    "keyword": {
      "foreground": "#3B6305",
      "bold": false
    },
    "operator": "#1E1C18",
    "string": "#933814"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7C8A6E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#3B6305",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#933814"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#63501F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#006B64"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#005E86"
      }
    },
    {
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#1D1D1D"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#1D1D1D"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1D1D1D"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3F5B48"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#7E8B72"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3B6305"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3F5B48"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7A6B4A"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#933814"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#2F3A26",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2F3A26",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#2F3A26",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#A64B4B"
      }
    },
    {
      "scope": [
        "support.class.component"
      ],
      "settings": {
        "foreground": "#006B64"
      }
    },
    {
      "scope": [
        "constant.language.import-export-all"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.template-expression",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#933814"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#3B6305",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.typeparameters",
        "punctuation.definition.bracket",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#1E1C18"
      }
    }
  ]
}
