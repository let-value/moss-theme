{
  "config": {
    "semantic_distance": 2,
    "color_distance": 6,
    "roles": [
      {
        "name": "main-text",
        "color": "#D4D1C8",
        "source": "moss/vscode.json:editor.foreground",
        "targets": [
          "UI: foreground",
          "UI: editor.foreground"
        ]
      },
      {
        "name": "numbers",
        "color": "#60CCFC",
        "source": "moss/vscode.json:number",
        "targets": [
          "TextMate: constant.numeric, constant.language",
          "Semantic: number"
        ]
      },
      {
        "name": "keywords",
        "color": "#96C66C",
        "source": "moss/vscode.json:keyword",
        "targets": [
          "TextMate: keyword, storage",
          "Semantic: keyword"
        ],
        "font_style": ""
      },
      {
        "name": "functions",
        "color": "#E2CC95",
        "source": "moss/vscode.json:function",
        "targets": [
          "TextMate: entity.name.function, support.function",
          "Semantic: function",
          "Semantic: method"
        ]
      },
      {
        "name": "types",
        "color": "#2AA198",
        "source": "moss/vscode.json:type",
        "targets": [
          "TextMate: entity.name.type, support.type, support.class",
          "Semantic: type",
          "Semantic: class",
          "Semantic: interface",
          "TextMate: support.class.component"
        ]
      },
      {
        "name": "variables",
        "color": "#CACACA",
        "source": "moss/vscode.json:variable",
        "targets": [
          "TextMate: variable",
          "Semantic: variable",
          "Semantic: variable.readonly",
          "TextMate: variable.other.constant"
        ]
      },
      {
        "name": "parameters",
        "color": "#CACACA",
        "source": "moss/vscode.json:parameter",
        "targets": [
          "TextMate: variable.parameter",
          "Semantic: parameter"
        ]
      },
      {
        "name": "properties",
        "color": "#AFD1BA",
        "source": "moss/vscode.json:property",
        "targets": [
          "TextMate: variable.other.property, support.variable.property",
          "Semantic: property"
        ]
      },
      {
        "name": "operators",
        "color": "#D4D1C8",
        "source": "moss/vscode.json:operator",
        "targets": [
          "TextMate: keyword.operator",
          "Semantic: operator",
          "TextMate: constant.language.import-export-all"
        ]
      },
      {
        "name": "tags",
        "color": "#96C66C",
        "source": "moss/vscode.json:keyword",
        "targets": [
          "TextMate: entity.name.tag"
        ]
      },
      {
        "name": "attributes",
        "color": "#AFD1BA",
        "source": "moss/vscode.json:property",
        "targets": [
          "TextMate: entity.other.attribute-name"
        ]
      },
      {
        "name": "strings",
        "color": "#DF7753",
        "source": "moss/vscode.json:string",
        "targets": [
          "TextMate: string",
          "Semantic: string",
          "TextMate: punctuation.definition.string, punctuation.definition.template-expression, punctuation.section.interpolation"
        ]
      },
      {
        "name": "module-keywords",
        "color": "#96C66C",
        "source": "moss/vscode.json:keyword",
        "font_style": "",
        "targets": [
          "TextMate: keyword.control.import, keyword.control.export, keyword.control.from"
        ]
      },
      {
        "name": "brackets",
        "color": "#2A392F",
        "source": "moss/vscode.json:editorBracketMatch.background",
        "targets": [
          "UI: editorBracketMatch.background"
        ]
      },
      {
        "name": "brackets-2",
        "color": "#7D9952",
        "source": "moss/vscode.json:editorBracketMatch.border",
        "targets": [
          "UI: editorBracketMatch.border",
          "UI: editorOverviewRuler.bracketMatchForeground"
        ]
      },
      {
        "name": "brackets-3",
        "color": "#D4D1C8",
        "source": "moss/vscode.json:editorBracketHighlight.foreground1",
        "targets": [
          "UI: editorBracketHighlight.foreground1",
          "UI: editorBracketHighlight.foreground2",
          "UI: editorBracketHighlight.foreground3",
          "UI: editorBracketHighlight.foreground5",
          "UI: editorBracketHighlight.foreground6",
          "UI: editorBracketHighlight.unexpectedBracket.foreground"
        ]
      },
      {
        "name": "brackets-4",
        "color": "#AFD1BA",
        "source": "moss/vscode.json:editorBracketHighlight.foreground4",
        "targets": [
          "UI: editorBracketHighlight.foreground4"
        ]
      },
      {
        "name": "bracket-punctuation",
        "color": "#D4D1C8",
        "source": "moss/vscode.json:editorBracketHighlight.foreground1",
        "targets": [
          "TextMate: punctuation.section, punctuation.definition.block, punctuation.definition.parameters, punctuation.definition.arguments, punctuation.definition.typeparameters, punctuation.definition.bracket, punctuation.definition.tag"
        ]
      }
    ]
  },
