{
  "semantic_distance": 2,
  "color_distance": 6,
  "roles": [
    {
      "name": "main-text",
      "color": "#1E1C18",
      "source": "palette/moss-light-source.json:editor.foreground",
      "targets": [
        "UI: foreground",
        "UI: editor.foreground"
      ]
    },
    {
      "name": "numbers",
      "color": "#005E86",
      "source": "palette/moss-light-source.json:number",
      "targets": [
        "TextMate: constant.numeric, constant.language",
        "Semantic: number"
      ]
    },
    {
      "name": "keywords",
      "color": "#3B6305",
      "source": "palette/moss-light-source.json:keyword",
      "targets": [
        "TextMate: keyword, storage",
        "Semantic: keyword"
      ],
      "font_style": ""
    },
    {
      "name": "functions",
      "color": "#63501F",
      "source": "palette/moss-light-source.json:function",
      "targets": [
        "TextMate: entity.name.function, support.function",
        "Semantic: function",
        "Semantic: method"
      ]
    },
    {
      "name": "types",
      "color": "#006B64",
      "source": "palette/moss-light-source.json:type",
      "targets": [
        "TextMate: entity.name.type, support.type, support.class",
        "Semantic: type",
        "Semantic: class",
        "Semantic: interface",
        "TextMate: support.class.component"
      ]
    },
    {
      "name": "variables",
      "color": "#1D1D1D",
      "source": "palette/moss-light-source.json:variable",
      "targets": [
        "TextMate: variable",
        "Semantic: variable",
        "Semantic: variable.readonly",
        "TextMate: variable.other.constant"
      ]
    },
    {
      "name": "parameters",
      "color": "#1D1D1D",
      "source": "palette/moss-light-source.json:parameter",
      "targets": [
        "TextMate: variable.parameter",
        "Semantic: parameter"
      ]
    },
    {
      "name": "properties",
      "color": "#3F5B48",
      "source": "palette/moss-light-source.json:property",
      "targets": [
        "TextMate: variable.other.property, support.variable.property",
        "Semantic: property"
      ]
    },
    {
      "name": "operators",
      "color": "#1E1C18",
      "source": "palette/moss-light-source.json:operator",
      "targets": [
        "TextMate: keyword.operator",
        "Semantic: operator",
        "TextMate: constant.language.import-export-all"
      ]
    },
    {
      "name": "tags",
      "color": "#3B6305",
      "source": "palette/moss-light-source.json:keyword",
      "targets": [
        "TextMate: entity.name.tag"
      ]
    },
    {
      "name": "attributes",
      "color": "#3F5B48",
      "source": "palette/moss-light-source.json:property",
      "targets": [
        "TextMate: entity.other.attribute-name"
      ]
    },
    {
      "name": "strings",
      "color": "#933814",
      "source": "palette/moss-light-source.json:string",
      "targets": [
        "TextMate: string",
        "Semantic: string",
        "TextMate: punctuation.definition.string, punctuation.definition.template-expression, punctuation.section.interpolation"
      ]
    },
    {
      "name": "module-keywords",
      "color": "#3B6305",
      "source": "palette/moss-light-source.json:keyword",
      "font_style": "",
      "targets": [
        "TextMate: keyword.control.import, keyword.control.export, keyword.control.from"
      ]
    },
    {
      "name": "brackets",
