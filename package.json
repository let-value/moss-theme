{
  "name": "moss-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp -C app dev",
    "build": "vp run -r build",
    "start": "vp run @moss/app#start",
    "test": "vp test",
    "check": "vp check app vite.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "format": "vp fmt app vite.config.ts tsconfig.json package.json pnpm-workspace.yaml"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.15.0"
}
